# Copy this file to .env and fill in the values for your provider.
# Never commit your real .env file.

# Provider: minimax, zai, openai, or anthropic.
TRADING_AGENT_PROVIDER=minimax

# Generic overrides. If set, these take priority over provider-specific values.
# TRADING_AGENT_API_KEY=
# TRADING_AGENT_BASE_URL=
# TRADING_AGENT_MODEL=
# TRADING_AGENT_QUICK_MODEL=
# TRADING_AGENT_DEEP_MODEL=

# MiniMax, the default provider.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
# TRADING_AGENT_MODEL=MiniMax-M2.7

# Z.ai.
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/anthropic
# TRADING_AGENT_MODEL=GLM-5.1

# OpenAI-compatible chat completions API.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
# TRADING_AGENT_MODEL=gpt-4o

# Anthropic-compatible Messages API.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
# TRADING_AGENT_MODEL=claude-sonnet-4-6

# Batch analysis concurrency. Keep at 1 for rate-limit-sensitive providers.
TRADING_AGENT_BATCH_CONCURRENCY=1

# Optional Yahoo Finance API base URL override.
# TRADING_AGENT_YAHOO_BASE_URL=https://query1.finance.yahoo.com

# Optional Rust logging filter.
# RUST_LOG=trading_agent_rs=info

# Legacy TAGENT_* variables are still accepted for compatibility.
