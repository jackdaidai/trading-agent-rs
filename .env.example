# Copy this file to .env and fill in the values for your provider.
# Never commit your real .env file.

# Provider: minimax, zai, openai, or anthropic.
TRADING_AGENT_PROVIDER=minimax

# Generic overrides. If set, these take priority over provider-specific values.
# TRADING_AGENT_API_KEY=
# TRADING_AGENT_BASE_URL=
# TRADING_AGENT_MODEL=
# TRADING_AGENT_QUICK_MODEL=
# TRADING_AGENT_DEEP_MODEL=

# MiniMax, the default provider.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
# TRADING_AGENT_MODEL=MiniMax-M2.7

# Z.ai.
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/anthropic
# TRADING_AGENT_MODEL=GLM-5.1

# OpenAI-compatible chat completions API.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
# TRADING_AGENT_MODEL=gpt-4o

# Anthropic-compatible Messages API.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
# TRADING_AGENT_MODEL=claude-sonnet-4-6

# Batch analysis concurrency: how many tickers run in parallel.
# Safe to raise (e.g. 4) — in-flight LLM requests are capped separately below.
TRADING_AGENT_BATCH_CONCURRENCY=1

# Max concurrent in-flight LLM requests across the whole process (default 4).
# This is the knob that protects against provider 429 rate limits.
# TRADING_AGENT_LLM_CONCURRENCY=4

# Set to "off" to disable extended thinking on quick-model calls
# (debate/risk agents). Faster with reasoning models like MiniMax-M2/GLM,
# at some cost in argument depth. Default: on.
# TRADING_AGENT_QUICK_THINKING=on

# LLM request timeout in seconds (default 240). Deep-synthesis calls on
# reasoning models can legitimately run for several minutes.
# TRADING_AGENT_LLM_TIMEOUT=240

# Max output tokens for Anthropic-format responses (default 4096).
# A warning is logged when a response is truncated at this limit.
# TRADING_AGENT_MAX_TOKENS=4096

# Optional Yahoo Finance API base URL override.
# TRADING_AGENT_YAHOO_BASE_URL=https://query1.finance.yahoo.com

# Optional Rust logging filter.
# RUST_LOG=trading_agent_rs=info

# Legacy TAGENT_* variables are still accepted for compatibility.
