# Copy this file to .env and fill in the values for your provider.
# Never commit your real .env file.

# Provider: minimax, zai, openai, or anthropic.
TAGENT_PROVIDER=minimax

# Generic overrides. If set, these take priority over provider-specific values.
# TAGENT_API_KEY=
# TAGENT_BASE_URL=
# TAGENT_MODEL=
# TAGENT_QUICK_MODEL=
# TAGENT_DEEP_MODEL=

# MiniMax, the default provider.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
# TAGENT_MODEL=MiniMax-M2.7

# Z.ai.
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/anthropic
# TAGENT_MODEL=GLM-5.1

# OpenAI-compatible chat completions API.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
# TAGENT_MODEL=gpt-4o

# Anthropic-compatible Messages API.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
# TAGENT_MODEL=claude-sonnet-4-6

# Batch analysis concurrency. Keep at 1 for rate-limit-sensitive providers.
TAGENT_BATCH_CONCURRENCY=1

# Optional path to the Python Yahoo Finance proxy script.
TAGENT_YFINANCE_PROXY=yfinance_proxy.py

# Optional Rust logging filter.
# RUST_LOG=tagent=info
